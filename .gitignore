# Environment and secret files
.env
.env.*
!.env.example

# Ruby / Rails
/backend/.bundle
/backend/log/*
/backend/tmp/*
/backend/storage/*
/backend/vendor/bundle
/backend/coverage
# RSpec's --only-failures state; local to each machine.
/backend/spec/examples.txt
/backend/config/master.key
/backend/config/credentials/*.key

# Node / Vite
/frontend/node_modules
/frontend/dist
/frontend/.vite

# Operating system and editor files
.DS_Store
Thumbs.db
.idea
.vscode

# Terraform state and local overrides
/terraform/.terraform
/terraform/**/*.tfstate
/terraform/**/*.tfstate.*
/terraform/**/*.tfvars
!/terraform/**/*.tfvars.example
/terraform/**/*.tfplan
crash.log

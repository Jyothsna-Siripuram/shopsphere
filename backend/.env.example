# Development only; do not use these credentials outside a local machine.
DATABASE_URL=postgresql://shopsphere:shopsphere_development_password@db:5432/shopsphere_development
TEST_DATABASE_URL=postgresql://shopsphere:shopsphere_development_password@db:5432/shopsphere_test
REDIS_URL=redis://redis:6379/0
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=debug

# Browser origins permitted to call the API. Comma separated, no wildcard: the
# refresh endpoint sends credentials, and CORS forbids a wildcard origin with
# credentials. A wildcard would also let any site invoke the API with a victim's
# cookies attached.
ALLOWED_ORIGINS=http://localhost:5173

# Access token signing key, HS256.
#
# Optional in development and test, where it is derived from secret_key_base so
# a fresh clone runs without setup. REQUIRED in staging and production, where
# boot fails without it rather than silently running a derived key.
#
# Generate with: openssl rand -hex 32
# In production this comes from AWS Secrets Manager, never from a file.
# JWT_SECRET_KEY=

source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 8.1.3", ">= 8.1.3.1"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"

# Compatibility pin, not a preference.
#
# ActiveSupport 8.1.3.1 calls `::JSON.parse(json, options)` with options as a
# POSITIONAL argument (active_support/json/decoding.rb:24). The json 3.0 series
# — a default gem in Ruby 4.0 — accepts only one positional argument, so every
# read of a jsonb attribute raises ArgumentError: wrong number of arguments.
# That breaks orders.shipping_address on every load.
#
# Remove this pin once Rails ships a release that calls JSON.parse with
# keyword arguments.
gem "json", "~> 2.9"
# Redis-backed Rails caching. Sidekiq is introduced when background jobs are built.
gem "redis-client", "~> 0.28"
gem "redis", "~> 5.4"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
# gem "jbuilder"
# Use Redis adapter to run Action Cable in production
# gem "redis", ">= 4.0.1"

# Password hashing behind has_secure_password. Argon2id is the stronger modern
# KDF, but bcrypt is the Rails-native, widely-audited default and needs no
# custom integration. The digest column is opaque, so switching later is a
# rehash-on-next-login migration rather than a schema change.
gem "bcrypt", "~> 3.1.7"

# JWT encoding and decoding. Hand-rolling HMAC means personally owning the
# alg:"none" confusion attack, constant-time signature comparison and claim
# validation, which is a well-known route to a critical vulnerability.
# devise-jwt was rejected because it brings Warden and session machinery that
# an API-only application does not need.
gem "jwt", "~> 2.9"

# Authorization as one plain Ruby object per resource.
#
# CanCanCan centralises every rule in a single Ability class, which becomes a
# god object that is hard to unit test one rule at a time. action_policy is a
# strong alternative with built-in caching and explicit contexts, and would be
# worth revisiting at a larger scale. Pundit's POROs keep each resource's rules
# isolated and trivially testable, which is what this codebase needs.
gem "pundit", "~> 2.5"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "~> 1.2"

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
# gem "rack-cors"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false

  # Request, service, and model testing for the API.
  gem "rspec-rails", "~> 8.0"

  # Per-test data with explicit intent. Rails fixtures are a global dataset
  # shared by every spec, which obscures which attribute a test actually
  # depends on and grows brittle with the schema. Factories cost a little
  # suite speed when they build deep graphs; build_stubbed is used wherever
  # persistence is not required.
  gem "factory_bot_rails", "~> 6.4"
end
